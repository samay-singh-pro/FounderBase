# FoundrBase Backend Environment Variables

# JWT Settings
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database — SQLite by default. Use a Postgres URL (e.g. Neon free tier) to persist data in production.
DATABASE_URL=sqlite:///./app.db

# CORS — comma-separated frontend origin(s), or * for any (default).
# Production example: CORS_ORIGINS=https://foundrbase-web.onrender.com
CORS_ORIGINS=*

# Google Gemini AI (Optional - for AI writing assistant)
# Get your API key from: https://makersuite.google.com/app/apikey
GOOGLE_GEMINI_API_KEY=your-google-gemini-api-key-here
GEMINI_MODEL=models/gemini-flash-lite-latest

# Cloudinary (Optional - for real media uploads)
# Sign up at https://cloudinary.com/users/register/free
# Then visit https://console.cloudinary.com/ and copy from the "Product Environment Credentials" card.
# Leave blank to use the local-disk stub (files go to backend/uploads/, served at /uploads/...).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# GIPHY (Optional - for the chat/comment GIF picker)
# Create an app at https://developers.giphy.com/dashboard/ and use the "API Key" (not SDK key).
# Leave blank to return a canned stub set of GIFs.
GIPHY_API_KEY=
